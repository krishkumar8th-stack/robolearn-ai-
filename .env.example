# GEMINI_API_KEY: Required for Gemini AI API calls.
# Keep this secret on the server only; never expose it in client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model Configuration
AI_PRIMARY_MODEL="gemini-3.8-flash"
AI_FAST_MODEL="gemini-3.8-flash"

# Production database. Required for user registration, login, profiles and progress.
# Use a MongoDB Atlas connection string or another MongoDB deployment.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority"

# Authentication secret. REQUIRED in production. Use a long random value.
JWT_SECRET="replace-with-a-long-random-production-secret"
CLIENT_URL="http://localhost:3000"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
