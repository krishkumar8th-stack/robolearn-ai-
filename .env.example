# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Model Configuration
AI_PRIMARY_MODEL="gemini-3.8-flash"
AI_FAST_MODEL="gemini-3.8-flash"

# Database Configuration (Optional MongoDB URI; falls back to persistent in-memory/JSON storage if unset)
MONGODB_URI=""

# Authentication & Server
JWT_SECRET="roblearn-ai-jwt-secret-key-production"
CLIENT_URL="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

